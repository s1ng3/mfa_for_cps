# Copy to .env (or export these) before running the backend. All have sane defaults.

# --- Profile -------------------------------------------------------------
# 'postgres' (default) or 'h2' for a zero-infra in-memory demo.
SPRING_PROFILE=postgres

# --- Database (postgres profile) -----------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/cps_mfa
DB_USERNAME=cps_mfa
DB_PASSWORD=cps_mfa

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Session policy ------------------------------------------------------
SESSION_IDLE_MINUTES=5
SESSION_ABSOLUTE_MINUTES=30
SESSION_ADMIN_MINUTES=15
STEP_UP_VALIDITY_SECONDS=120

# --- OTP policy ----------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=30

# --- Recovery codes ------------------------------------------------------
RECOVERY_CODE_COUNT=10

# --- MFA mock ------------------------------------------------------------
# When true, generated OTPs are printed to the backend console (demo email/SMS sink).
MFA_MOCK_PRINT_OTP=true

# --- Working hours (risk engine) -----------------------------------------
WORK_HOURS_START=7
WORK_HOURS_END=19
